{
  "rules": {
    ".read": false,
    ".write": false,
    "watch": {
      "$shareId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['ownerUid', 'updatedAt', 'expiresAt', 'payload']) && newData.child('ownerUid').val() === auth.uid && newData.child('payload').isString() && newData.child('payload').val().length < 200000"
      }
    },
    "events": {
      "$eventId": {
        ".read": true,
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['ownerUid', 'name', 'plan', 'createdAt', 'expiresAt']) && newData.child('ownerUid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('plan').isString() && newData.child('plan').val().length < 500000"
        },
        "live": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('events').child($eventId).child('meta').child('expiresAt').val() > now",
            ".validate": "newData.hasChildren(['matchKey', 'updatedAt', 'payload']) && newData.child('matchKey').isString() && newData.child('matchKey').val().length < 50 && newData.child('payload').isString() && newData.child('payload').val().length < 200000"
          }
        },
        "submissions": {
          "$matchKey": {
            ".write": "auth != null && root.child('events').child($eventId).child('meta').child('expiresAt').val() > now && (root.child('events').child($eventId).child('meta').child('ownerUid').val() === auth.uid || (newData.child('courtUid').val() === auth.uid && newData.child('status').val() === 'submitted' && (!data.exists() || data.child('status').val() !== 'approved')))",
            ".validate": "$matchKey.matches(/^s[0-9]+-g[0-9]+-[0-9]+$/) && newData.hasChildren(['courtUid', 'submittedAt', 'payload', 'status', 'note']) && newData.child('payload').isString() && newData.child('payload').val().length < 200000 && newData.child('status').val().matches(/^(submitted|approved|returned)$/) && newData.child('note').isString() && newData.child('note').val().length <= 500"
          }
        }
      }
    }
  }
}
