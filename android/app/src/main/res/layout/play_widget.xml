<?xml version="1.0" encoding="utf-8"?>
<!-- 「今すぐ PLAY」ウィジェット。スキットルそのものをボタンに見立てる -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/play_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/play_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/play_widget_name"
        android:src="@drawable/play_widget_skittle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:letterSpacing="0.12"
        android:text="@string/play_widget_label"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
