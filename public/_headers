# Cloudflare Pages の配信設定（GitHub Pages では読まれない）
# 更新を確実に届けるため、サービスワーカーと入口のページは毎回確かめさせる
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
# お知らせはアプリ版（端末内のファイルから動く）からも読むので、ほかの場所からの読み込みを許す
/news.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
